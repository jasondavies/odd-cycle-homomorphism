/-- Exhaustive evaluation of the proved-complete search. -/
theorem assignments_thirteen : assignments 13 = [List.range 13] := by
  rw [checkpoint13]
  decide

/-- All endomorphisms of the concrete gadget fix every vertex. -/
theorem rigid (f : ℕ → ℕ) (hb : ∀ i < 13, f i < 13)
    (hh : ∀ i < 13, ∀ j < i, Adj i j → Adj (f i) (f j)) :
    ∀ i < 13, f i = i := by
  have hp := assignments_complete f 13 hb hh
  rw [assignments_thirteen, List.mem_singleton] at hp
  intro i hi
  have he := congrArg (fun xs : List ℕ => xs[i]?) hp
  simpa only [initialValues, List.getElem?_ofFn, List.getElem?_range hi, dite_eq_left hi, Option.some.injEq] using he

/-- The certificate's graph as an ordinary simple graph. -/
def graph : SimpleGraph (Fin 13) where
  Adj u v := Adj u.val v.val
  symm := ⟨fun {u v} h => adj_symm u v h⟩
  loopless := ⟨by decide⟩

instance : DecidableRel graph.Adj := fun u v => inferInstanceAs (Decidable (Adj u.val v.val))

/-- Rigidity stated for mathlib graph homomorphisms, with no side conditions. -/
theorem rigid_hom (f : graph →g graph) : ∀ v, f v = v := by
  let g : ℕ → ℕ := fun n => if h : n < 13 then (f ⟨n, h⟩).val else 0
  have hb : ∀ i < 13, g i < 13 := by
    intro i hi
    simp [g, hi]
  have hh : ∀ i < 13, ∀ j < i, Adj i j → Adj (g i) (g j) := by
    intro i hi j hj he
    have hj' : j < 13 := by omega
    have hf := f.map_adj (show graph.Adj ⟨i, hi⟩ ⟨j, hj'⟩ from he)
    simpa [graph, g, hi, hj'] using hf
  intro v
  apply Fin.ext
  simpa [g, v.isLt] using rigid g hb hh v.val v.isLt

/-- The ordered ports a and b are distinct and nonadjacent. -/
theorem ports_separated : (8 : Fin 13) ≠ 10 ∧ ¬ graph.Adj 8 10 := by decide

