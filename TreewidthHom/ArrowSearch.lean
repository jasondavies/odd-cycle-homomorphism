module

public import Mathlib

@[expose] public section

/-!
# Complete finite certificate for the 13-vertex direction gadget

Vertices are ordered B,A,x,z,y,D,C,t,a,u,b,v,w so that the complete search
can prune edges early. The search has a general completeness proof below;
the concrete evaluation is checked by the Lean kernel, not native_decide.
-/
namespace TreewidthHom.Arrow

set_option maxRecDepth 100000

/-- The 15 undirected edges in the pruning order described above. -/
def edges : List (ℕ × ℕ) := [(0, 1), (0, 2), (0, 3), (1, 8), (1, 10), (2, 4), (3, 5), (4, 6), (5, 7), (5, 12), (6, 7), (6, 9), (8, 9), (10, 11), (11, 12)]

/-- Adjacency table, checked against the edge list below. -/
def neighbors : ℕ → List ℕ
  | 0 => [1, 2, 3]
  | 1 => [0, 8, 10]
  | 2 => [0, 4]
  | 3 => [0, 5]
  | 4 => [2, 6]
  | 5 => [3, 7, 12]
  | 6 => [4, 7, 9]
  | 7 => [5, 6]
  | 8 => [1, 9]
  | 9 => [6, 8]
  | 10 => [1, 11]
  | 11 => [10, 12]
  | 12 => [5, 11]
  | _ => []

def Adj (u v : ℕ) : Prop := v ∈ neighbors u

instance : DecidableRel Adj := fun u v => inferInstanceAs (Decidable (v ∈ neighbors u))

theorem adj_iff_edges : ∀ u v : Fin 13,
    Adj u.val v.val ↔ (u.val, v.val) ∈ edges ∨ (v.val, u.val) ∈ edges := by decide

theorem adj_symm : ∀ u v : Fin 13, Adj u.val v.val → Adj v.val u.val := by decide

/-- Check all edges from the new source vertex to already assigned vertices. -/
def Compatible (xs : List ℕ) (y : ℕ) : Prop :=
  ∀ j : Fin xs.length, Adj xs.length j.val → Adj y xs[j.val]

instance (xs : List ℕ) (y : ℕ) : Decidable (Compatible xs y) :=
  inferInstanceAs (Decidable (∀ j : Fin xs.length, Adj xs.length j.val → Adj y xs[j.val]))

def extensions (xs : List ℕ) : List (List ℕ) :=
  ((List.range 13).filter (fun y => decide (Compatible xs y))).map (fun y => xs ++ [y])

def assignments : ℕ → List (List ℕ)
  | 0 => [[]]
  | n+1 => (assignments n).flatMap extensions

def initialValues (f : ℕ → ℕ) (n : ℕ) : List ℕ := List.ofFn (fun j : Fin n => f j.val)

theorem initialValues_succ (f : ℕ → ℕ) (n : ℕ) : initialValues f (n+1) = initialValues f n ++ [f n] := by
  simp only [initialValues, List.ofFn_succ', Fin.val_castSucc, Fin.val_last, List.concat_eq_append]

/-- Every bounded map preserving source edges occurs in the search. -/
theorem assignments_complete (f : ℕ → ℕ) (n : ℕ)
    (hb : ∀ i < n, f i < 13)
    (hh : ∀ i < n, ∀ j < i, Adj i j → Adj (f i) (f j)) :
    initialValues f n ∈ assignments n := by
  induction n with
  | zero => simp [initialValues, assignments]
  | succ n ih =>
    have hp : initialValues f n ∈ assignments n := ih
      (fun i hi => hb i (by omega)) (fun i hi => hh i (by omega))
    rw [initialValues_succ]
    apply List.mem_flatMap.mpr
    refine ⟨initialValues f n, hp, ?_⟩
    apply List.mem_map.mpr
    refine ⟨f n, ?_, rfl⟩
    simp only [List.mem_filter, List.mem_range, decide_eq_true_eq]
    refine ⟨hb n (by omega), ?_⟩
    simp only [Compatible, initialValues, List.length_ofFn, List.getElem_ofFn]
    intro j h
    exact hh n (by omega) j.val (by simpa using j.isLt) h

